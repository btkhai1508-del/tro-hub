{
  "name": "tro-hub-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply tro-hub --local",
    "db:seed:local": "node scripts/seed.ts > .wrangler/seed.sql && wrangler d1 execute tro-hub --local --file .wrangler/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply tro-hub --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
